  variant stable

  # Mixing options
  weight 0.1500
  weight.linear 0.1500
  history 9
  restart 9
  restart.save 1

  # Continuation options
  iterations 9
  next Linear-Kick
%endblock SCF.Mixer.Pulay

%block SCF.Mixer.Linear-Kick
  # Mixing method
  method linear

  # Mixing options
  weight 0.5000

  # Continuation options
  iterations 1
  next Pulay
%endblock SCF.Mixer.Linear-Kick

