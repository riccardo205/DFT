#DON'T FORGET TO PUT THE .PSF FILE TO THE SAME DIRECTORY
SystemName          Short 2OS                     # Name of the system we want to investigate
SystemLabel         short-2OS                       # name of output files
NumberOfAtoms       85                                # how many number in the unit cell? Dimer -> 2 atoms
NumberOfSpecies     2                                # how many different type of atoms? Dimer -> 1
%block ChemicalSpeciesLabel
 1  6  C        # Species index, atomic number, species label
 2  1  H        # Species index, atomic number, species label
%endblock ChemicalSpeciesLabel
# ----------------------
# STRUCTURAL INFORMATION
# ----------------------
LatticeConstant     1.0 Ang
%block LatticeVectors
   30.000000    0.000000    0.000000
    0.000000   20.000000    0.000000
    0.000000    0.000000   20.000000
%endblock LatticeVectors
