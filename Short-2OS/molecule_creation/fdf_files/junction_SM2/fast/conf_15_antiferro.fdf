#DON'T FORGET TO PUT THE .PSF FILE TO THE SAME DIRECTORY

SystemName          short 2OS                     # Name of the system we want to investigate
SystemLabel         short-2OS                       # name of output files
NumberOfAtoms       126                                # how many number in the unit cell? Dimer -> 2 atoms
NumberOfSpecies     3                                # how many different type of atoms? Dimer -> 1

%block ChemicalSpeciesLabel 
 1  6  C        # Species index, atomic number, species label
 2  1  H        # Species index, atomic number, species label
 3  79 Au        # Species index, atomic number, species label
%endblock ChemicalSpeciesLabel

# ----------------
# BASIS DEFINITION
# ----------------
PAO.EnergyShift   5 meV
PAO.Splitnorm     0.15
PAO.SplitnormH    0.5

%block PAO.Basis                 # Define Basis set: This is Triple zeta polarized
C                     2                    # Species label, number of l-shells
 n=2   0   3                         # n, l, Nzeta 
   0.0      0.0   0.0      
 n=2   1   3 P   1                   # n, l, Nzeta, Polarization, NzetaPol
   0.0      0.0   0.0   
H                     1                    # Species label, number of l-shells
 n=1   0   3 P   1                   # n, l, Nzeta, Polarization, NzetaPol
   0.0      0.0   0.0   
Au                    3  # Species label, number of l-shells
 n=6   0   2 P   1       # n, l, Nzeta, Polarization, NzetaPol
   0.0  0.0
 n=6   1   2 P   1
   0.0  0.0
 n=5   2   2 P   1
   0.0  0.0

%endblock PAO.Basis


# ----------------------
# STRUCTURAL INFORMATION
# ----------------------
LatticeConstant     1.0 Ang
%block LatticeVectors
   50.000000    0.000000    0.000000
    0.000000   25.000000    0.000000
    0.000000    0.000000   25.000000
%endblock LatticeVectors

AtomicCoordinatesFormat Ang
