# --
# XC
# --
xc.functional	        GGA	
xc.authors		PBE	

# --
# VdW interactions (Grimme DFT-D3)
# --
DFTD3              T
DFTD3.UseXCDefaults T
DFTD3.BJdamping     T

# ----
# GRID
# ----
MeshCutoff 		500 Ry
Grid.CellSampling        3 3 3

# ---------------
# Solution Method
# ---------------
SolutionMethod		diagon
ElectronicTemperature	1 K	

# ---
# SCF
# ---
SCF.DM.Tolerance         1.E-6
SCF.H.Tolerance          1.E-5 eV
SCF.Mix                  Hamiltonian
SCF.Mix.Spin             all
SCF.Mixer.Method         Pulay
SCF.Mixer.Weight         0.05
SCF.Mixer.Kick           0
SCF.Mixer.History        10
MaxSCFIterations	       500
DM.UseSaveDM	     	     F
SaveHS                   T

# --
# MD
# --
MD.TypeOfRun   	        CG  
MD.Steps                500
MD.MaxCGDispl           0.003 Ang #0.02 Ang
MD.UseSaveXV            T
MD.MaxForceTol          0.020 eV/Ang
#MD.MaxStressTol         0.0001 GPa
#MD.TargetPressure       0.0001 GPa

# --
# SPINS
# --
Spin  polarized
# --
# SPINS
# --
Spin  polarized
%block DM.InitSpin
   29  -1.0
   42  1.0
%endblock DM.InitSpin

# --------------
# OUTPUT OPTIONS
# --------------
WriteEigenvalues       F
WriteForces            T
WriteCoorStep          T
WriteCoorXmol          T     # generate the .xyz file 
WriteMDXmol            T     # generate the .ani file 
WriteMullikenPop       1
Write.HirshfeldPop     T
Write.VoronoiPop       T


Write.DM.NetCDF        T
Write.DMHS.NetCDF      T

