#DON'T FORGET TO PUT THE .PSF FILE TO THE SAME DIRECTORY

SystemName          short 2OS                     # Name of the system we want to investigate
SystemLabel         short-2OS                       # name of output files
NumberOfAtoms       20                                # how many number in the unit cell? Dimer -> 2 atoms
NumberOfSpecies     1                                # how many different type of atoms? Dimer -> 1

%block ChemicalSpeciesLabel 
 1  79 Au        # Species index, atomic number, species label
%endblock ChemicalSpeciesLabel

# ----------------
# BASIS DEFINITION
# ----------------
PAO.EnergyShift   5 meV
PAO.Splitnorm     0.15
PAO.SplitnormH    0.5

%block PAO.Basis                 # Define Basis set: This is Triple zeta polarized
Au                    3  # Species label, number of l-shells
 n=6   0   2 P   1       # n, l, Nzeta, Polarization, NzetaPol
   0.0  0.0
 n=6   1   2 P   1
   0.0  0.0
 n=5   2   2 P   1
   0.0  0.0
%endblock PAO.Basis


# ----------------------
# STRUCTURAL INFORMATION
# ----------------------
LatticeConstant     1.0 Ang
%block LatticeVectors
   15.000000    0.000000    0.000000
    0.000000   15.000000    0.000000
    0.000000    0.000000   15.000000
%endblock LatticeVectors

AtomicCoordinatesFormat Ang
%block AtomicCoordinatesAndAtomicSpecies
     -0.000000      0.000000     -5.287100        1
     -0.830800      1.439000     -2.937300        1
     -0.830800     -1.439000     -2.937300        1
      1.661600      0.000000     -2.937300        1
     -1.661600      2.877900     -0.587500        1
     -1.661600      0.000000     -0.587500        1
      0.830800      1.439000     -0.587500        1
     -1.661600     -2.877900     -0.587500        1
      0.830800     -1.439000     -0.587500        1
      3.323100      0.000000     -0.587500        1
     -2.492400      4.316900      1.762400        1
     -2.492400      1.439000      1.762400        1
     -0.000000      2.877900      1.762400        1
     -2.492400     -1.439000      1.762400        1
     -0.000000      0.000000      1.762400        1
      2.492400      1.439000      1.762400        1
     -2.492400     -4.316900      1.762400        1
     -0.000000     -2.877900      1.762400        1
      2.492400     -1.439000      1.762400        1
      4.984700      0.000000      1.762400        1
%endblock AtomicCoordinatesAndAtomicSpecies

# --
# XC
# --
xc.functional	        GGA	
xc.authors		PBE	

# ----
# GRID
# ----
MeshCutoff 		500 Ry
Grid.CellSampling        3 3 3

# ---------------
# Solution Method
# ---------------
SolutionMethod		diagon
ElectronicTemperature	1 K	

# ---
# SCF
# ---
SCF.DM.Tolerance         1.E-6
SCF.H.Tolerance          1.E-5 eV
SCF.Mix                  Hamiltonian
SCF.Mix.Spin             all
SCF.Mixer.Method         Pulay
SCF.Mixer.Weight         0.05
SCF.Mixer.Kick           0
SCF.Mixer.History        10
MaxSCFIterations	       500
DM.UseSaveDM	     	     F
SaveHS                   T

# --
# MD
# --
MD.TypeOfRun   	        CG  
MD.Steps                500
MD.MaxCGDispl           0.01 Ang #0.02 Ang
MD.UseSaveXV            T
MD.MaxForceTol          0.005 eV/Ang
#MD.MaxStressTol         0.0001 GPa
#MD.TargetPressure       0.0001 GPa


# --------------
# OUTPUT OPTIONS
# --------------
WriteEigenvalues       F
WriteForces            T
WriteCoorStep          T
WriteCoorXmol          T     # generate the .xyz file 
WriteMDXmol            T     # generate the .ani file 
WriteMullikenPop       1
Write.HirshfeldPop     T
Write.VoronoiPop       T


Write.DM.NetCDF        T
Write.DMHS.NetCDF      T

