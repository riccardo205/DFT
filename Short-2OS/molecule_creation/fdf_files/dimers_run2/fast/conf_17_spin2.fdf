# --
# XC
# --
xc.functional	        GGA	
xc.authors		PBE	

# ----
# GRID
# ----
MeshCutoff 		300 Ry

# ---------------
# Solution Method
# ---------------
SolutionMethod		diagon
ElectronicTemperature	300 K	

# ---
# SCF
# ---
SCF.DM.Tolerance         5.E-6
SCF.H.Tolerance          5.E-5 eV
SCF.Mix                  Hamiltonian
SCF.Mix.Spin             all
SCF.Mixer.Method         Pulay
SCF.Mixer.Weight         0.15
SCF.Mixer.Kick           10
SCF.Mixer.History        20
MaxSCFIterations	       200
DM.UseSaveDM	     	    T
SaveHS                   T

# --
# MD
# --
MD.TypeOfRun   	        CG  
MD.Steps                500
MD.MaxCGDispl           0.05 Ang #0.02 Ang
MD.UseSaveXV            T
MD.MaxForceTol          0.001 eV/Ang
MD.MaxStressTol         0.0001 GPa
MD.TargetPressure       0.0001 GPa

# --
# SPINS
# --
Spin  polarized
# --
# SPINS
# --
Spin  polarized
%block DM.InitSpin
   29  1.0
   42  1.0
   115 1.0
   128 1.0
%endblock DM.InitSpin

# --------------
# OUTPUT OPTIONS
# --------------
WriteEigenvalues       F
WriteForces            T
WriteCoorStep          T
WriteCoorXmol          T     # generate the .xyz file 
WriteMDXmol            T     # generate the .ani file 
WriteMullikenPop       1
Write.HirshfeldPop     T
Write.VoronoiPop       T


Write.DM.NetCDF        T
Write.DMHS.NetCDF      T

