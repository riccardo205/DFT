    if args.dir=='None':
        inpdir = input("Select direction of the stretching (also given by -dir, join for the direction that connects the atoms): ")
    else:
        inpdir = args.dir
    if args.dir=='join':
        strdir = inpxyz[at2]-inpxyz[at1]
    else:
        strdir = np.array(inpdir.split(",")).astype(float)
    if len(strdir) != 3:
        print("Invalid direction. 3 cartesian coordinates must be given, separated by , (example 1,0,0). bye!")
        quit()
    if args.disp=='None':
        disp = float(input("Select displacement of stretching (negative for compression), (also given by -disp): "))
    else:
        disp = float(args.disp)    
    r12 = inpxyz[at2] - inpxyz[at1]
    udir = strdir / np.linalg.norm(strdir)
    pldir = np.dot(udir, r12) * udir
    plnorm = np.dot(udir, r12)
    newcoord = np.zeros((natoms,3))
    for iatom in range(natoms):
        rrel = inpxyz[iatom] - inpxyz[at1]
        proy = np.dot(rrel, udir)
        if proy > 0 and proy < plnorm:
            newcoord[iatom] = inpxyz[iatom] + proy / plnorm * disp * udir
        elif proy <= 0:
            newcoord[iatom] = inpxyz[iatom]
        elif proy >= plnorm:
            newcoord[iatom] = inpxyz[iatom] + disp * udir 
    if args.outfilename=='None':
        outfilename = input("Select the output filename: ")
