#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# A code to perform several actions over xyz files

# Amador García Fuente. Universidad de Oviedo. 2021

import numpy as np
#import matplotlib.pyplot as plt
import argparse
import scipy.spatial.distance
from timeit import default_timer as timer

# Parsing del input
parser = argparse.ArgumentParser()

parser.add_argument('-i','-input', help='Input file name', required=True, dest='inpfilename')
parser.add_argument('-m','-mode', help='Mode of the script',type=int, required=False, default='-1', dest='inpmode')
parser.add_argument('-refindex', help='Index for atom of reference', type=int, required=False, default='-1', dest='refindex')
parser.add_argument('-dcrit', help='Critical distance for calculations', type=float, required=False, default='-1', dest='dcrit')
parser.add_argument('-reftype', help='Type of atom of reference', required=False, default='None', dest='reftype')
parser.add_argument('-nx', help='Repetitions in X direction', required=False, type=int, default='1', dest='nx')
parser.add_argument('-ny', help='Repetitions in Y direction', required=False, type=int, default='1', dest='ny')
parser.add_argument('-nz', help='Repetitions in Z direction', required=False, type=int, default='1', dest='nz')
parser.add_argument('-nsc', help='Number of cells on each size to generate supercell', required=False, type=int, default='0', dest='nsc')
parser.add_argument('-o','-output', help='Output file name', required=False, default='None', dest='outfilename')
parser.add_argument('-stack', help='Stacking option (all/each)', required=False, default='all', dest='stack')
parser.add_argument('-types', help='Order of the types of atoms to create fdf', required=False, default='None', dest='types')
parser.add_argument('-axis', help='Axis to generate rotations', required=False, default='None', dest='axis')
parser.add_argument('-plane', help='Plane defined by its normal axis', required=False, default='None', dest='plane')
parser.add_argument('-angle', help='Rotation angle (degrees)', required=False, default='None', dest='angle')
parser.add_argument('-at1', help='Index of atom 1 of reference, when several are needed', required=False, default='None',dest='at1')
parser.add_argument('-at2', help='Index of atom 2 of reference, when several are needed', required=False, default='None',dest='at2')
parser.add_argument('-dir', help='Direction for stretching', required=False, default='None',dest='dir')
parser.add_argument('-disp',help='Displacement for stretching or to move the structure', required=False, default='None', dest='disp')

args = parser.parse_args()

print("\n\nProgram by Amador García Fuente. Universidad de Oviedo. 2021")
print("------------------------------------------------------------")

# READ INPUT FILE

#print("Reading input file: %s\n" % args.inpfilename)
print("Reading input file: {}\n".format(args.inpfilename))

inputfile = open(args.inpfilename,"r")
inputlines = inputfile.readlines()
natoms = int(inputlines[0])
inpxyz = np.zeros((natoms,3))
inptypes = [];
for iatom in range(natoms):
    line = inputlines[iatom+2].split()
    inpxyz[iatom,0]=float(line[1])
    inpxyz[iatom,1]=float(line[2])
    inpxyz[iatom,2]=float(line[3])
    inptypes.append(line[0])
inplat = inputlines[1].split()
# Read lattice vectors from 1st line
inplattice = np.zeros((3,3))
if len(inplat)==1:
    inplattice[2,2] = float(inplat[0])       # If there is only 1 value, it is the displacement in the Z direction
elif len(inplat)==3:                 
    for j in range(3):
        inplattice[j,j] = float(inplat[j])   # If there are 3 values, they are the displacements in the X, Y and Z directions
elif len(inplat)==9:
    inplattice[0,0] = float(inplat[0])    # If there are 9 values, they are the 3 lattice vectors in cartesian coordinates
    inplattice[0,1] = float(inplat[1])    
    inplattice[0,2] = float(inplat[2])    
    inplattice[1,0] = float(inplat[3])    
    inplattice[1,1] = float(inplat[4])    
    inplattice[1,2] = float(inplat[5])    
    inplattice[2,0] = float(inplat[6])    
    inplattice[2,1] = float(inplat[7])    
    inplattice[2,2] = float(inplat[8])    
elif len(inplat)!=0:
    print("Error reading input file!, line 2 must be empty or contain lattice vectors")
    quit()

# CALCULATION OPTIONS
if args.inpmode==-1:
    print("You must define and option mode with -m or -mode. Diferent options are:\n")
    print("Mode 1: Calculate distances to 1 atom by index")
    print("Mode 2: Calculate distances to 1 type of atoms")
    print("Mode 3: Calculate angles around 1 atom by index")
    print("Mode 4: Calculate angles around 1 type of atoms")
    print("Mode 5: Duplicate structure in the directions of the lattice")
    print("Mode 6: Reorganize structure around 1 atom by index")
    print("Mode 7: Create a xyz file around a given atom by distance")
    print("Mode 8: Create fdf file from xyz structure")
    print("Mode 9: Calculate size of the structure")
    print("Mode 10: Rotate the structure around a given axis by a given angle")
    print("Mode 11: Rotate the structure to put an atom in a given direction")
    print("Mode 12: Rotate the structure around a given axis to put an atom in a given plane")
    print("Mode 13: Stretch the structure via 2 atoms")
    print("Mode 14: Move all the structure a given distance (or to move a given atom to the origin)")
# MODE 1: CALCULATE DISTANCES TO 1 ATOM BY INDEX
elif args.inpmode==1:
    print("\nMode 1 selected: Calculate distances to 1 atom by index\n")
    if args.refindex==-1:
        refindex = int(input("Select the index of the atom (also given by -refindex): "))
    else:
        refindex = args.refindex
    if refindex < 1 or refindex > natoms:
        print("Invalid reference index, bye!")
        quit()
    else:
        refindex = refindex - 1
        print("\nSelected atom index {:3d} of type {:>2} at position {:8.6f} {:8.6f} {:8.6f}\n".format(refindex+1,inptypes[refindex],inpxyz[refindex,0],inpxyz[refindex,1],inpxyz[refindex,2]))
    if args.dcrit==-1:
        dcrit = float(input("Select maximum distance to show (also given by -dcrit): "))  
    else:
        dcrit = args.dcrit
    if dcrit <=0:
        print("Invalid critical distance, bye!")
        quit()
    for iatom in range(natoms):
        if iatom == refindex:
            continue
        distance = np.linalg.norm(inpxyz[iatom]-inpxyz[refindex])
        if distance < dcrit:
            print("Found atom index {:3d} of type {:>2} at a distance {:8.6f}".format(iatom+1,inptypes[iatom],distance))
# MODE 2: CALCULATE DISTANCES TO 1 TYPE OF ATOMS
elif args.inpmode==2:
    print("\nMode 2 selected: Calculate distances to 1 type of atoms\n")
    if args.reftype=='None':
        reftype = input("Select the type of the atom (also given by -reftype): ")
    else:
        reftype = args.reftype
    if reftype not in inptypes:
        print("Atom type not found in file, bye!")
        quit()
    if args.dcrit==-1:
        dcrit = float(input("Select maximum distance to show (also given by -dcrit): "))
    else:
        dcrit = args.dcrit
    if dcrit <=0:
        print("Invalid critical distance, bye!")
        quit()
    for iatom1 in range(natoms):
        if inptypes[iatom1]==reftype:
            print("\nAtom of type {:>2} found with index {:3d} at position {:8.6f} {:8.6f} {:8.6f}\n".format(reftype,iatom1+1,inpxyz[iatom1,0],inpxyz[iatom1,1],inpxyz[iatom1,2]))
            for iatom2 in range(natoms):
                if iatom1==iatom2:
                    continue
                distance = np.linalg.norm(inpxyz[iatom1]-inpxyz[iatom2])
                if distance < dcrit:
                    print("Found atom index {:3d} of type {:>2} at a distance {:8.6f}".format(iatom2+1,inptypes[iatom2],distance))  
# MODE 3: CALCULATE ANGLES AROUND 1 ATOM BY INDEX
elif args.inpmode==3:
    print("\nMode 3 selected: Calculate angles around 1 atom by index\n")
    if args.refindex==-1:
        refindex = int(input("Select the index of the atom (also given by -refindex): "))
    else:
        refindex = args.refindex
    if refindex < 1 or refindex > natoms:
        print("Invalid reference index, bye!")
        quit()
    else:
        refindex = refindex - 1
        print("\nSelected atom index {:3d} of type {:>2} at position {:8.6f} {:8.6f} {:8.6f}\n".format(refindex+1,inptypes[refindex],inpxyz[refindex,0],inpxyz[refindex,1],inpxyz[refindex,2]))
    if args.dcrit==-1:
        dcrit = float(input("Select maximum distance to show (also given by -dcrit): "))
    else:
        dcrit = args.dcrit
    if dcrit <=0:
        print("Invalid critical distance, bye!")
        quit()
    closeatoms = np.empty(0,dtype=int)
    for iatom in range(natoms):
        if iatom == refindex:
            continue
        distance = np.linalg.norm(inpxyz[iatom]-inpxyz[refindex])
        if distance < dcrit:
            closeatoms = np.append(closeatoms, iatom)
    if len(closeatoms) < 2:
        print("Not enough atoms around found to calculate angles")
    else:
        for iatom1 in closeatoms:
            for iatom2 in closeatoms:
                if iatom1>=iatom2:
                     continue
                v1 = inpxyz[iatom1]-inpxyz[refindex]
                v2 = inpxyz[iatom2]-inpxyz[refindex]
                angle = 180/np.pi * np.arccos(np.dot(v1,v2)/np.linalg.norm(v1)/np.linalg.norm(v2))
                print("Angle of {:9.5f}º with positions of atom index {:3d} ({:>2}) and of index {:3d} ({:>2})".format(angle,iatom1+1,inptypes[iatom1],iatom2+1,inptypes[iatom2]))
# MODE 4: CALCULATE ANGLES AROUND 1 TYPE OF ATOMS
elif args.inpmode==4:
    print("\nMode 4 selected: Calculate angles around 1 type of atoms\n")
    if args.reftype=='None':
        reftype = input("Select the type of the atom (also given by -reftype): ")
    else:
        reftype = args.reftype
    if reftype not in inptypes:
        print("Atom type not found in file, bye!")
        quit()
    if args.dcrit==-1:
        dcrit = float(input("Select maximum distance to show (also given by -dcrit): "))
    else:
        dcrit = args.dcrit
    if dcrit <=0:
        print("Invalid critical distance, bye!")
        quit()
    for iref in range(natoms):
        if inptypes[iref]==reftype:
            print("\nAtom of type {:>2} found with index {:3d} at position {:8.6f} {:8.6f} {:8.6f}\n".format(reftype,iref+1,inpxyz[iref,0],inpxyz[iref,1],inpxyz[iref,2]))
            closeatoms = np.empty(0,dtype=int)
            for iatom in range(natoms):
                if iatom == iref:
                    continue
                distance = np.linalg.norm(inpxyz[iatom]-inpxyz[iref])
                if distance < dcrit:
                    closeatoms = np.append(closeatoms, iatom)
            if len(closeatoms) < 2:
                print("Not enough atoms around found to calculate angles")
            else:
                for iatom1 in closeatoms:
                    for iatom2 in closeatoms:
                        if iatom1>=iatom2:
                            continue
                        v1 = inpxyz[iatom1]-inpxyz[iref]
                        v2 = inpxyz[iatom2]-inpxyz[iref]
                        angle = 180/np.pi * np.arccos(np.dot(v1,v2)/np.linalg.norm(v1)/np.linalg.norm(v2))
                        print("Angle of {:9.5f}º with positions of atom index {:3d} ({:>2}) and of index {:3d} ({:>2})".format(angle,iatom1+1,inptypes[iatom1],iatom2+1,inptypes[iatom2]))
# MODE 5: DUPLICATE STRUCTURE IN THE DIRECTIONS OF THE LATTICE
elif args.inpmode==5:
    print("\nMode 5: Duplicate structure in the directions of the lattice (-stack optional all (default) / each)\n")
    if args.nx==1 and args.ny==1 and args.nz==1:
        nx = int(input("Select the number of repetitions in the X direction (also given by -nx): "))
        ny = int(input("Select the number of repetitions in the Y direction (also given by -ny): "))
        nz = int(input("Select the number of repetitions in the Z direction (also given by -nz): "))
    else:
        nx = args.nx
        ny = args.ny
        nz = args.nz
    if min((nx,ny,nz))<1:
        print("Number of repetitiones must be equal or larger than 1")
        quit()
    if args.outfilename=='None':
        outfilename = input("Select the output filename: ")
    else:
        outfilename = args.outfilename
    outputfile = open(outfilename,"w")
    outputfile.write("  {:d} ".format(natoms*nx*ny*nz))
    if len(inplat)==1:
        outputfile.write("\n  {:12.6f}".format(inplattice[2,2]*nz))
    elif len(inplat)==3:
        outputfile.write("\n  {:12.6f} {:12.6f} {:12.6f}".format(inplattice[0,0]*nx, inplattice[1,1]*ny, inplattice[2,2]*nz))
    elif len(inplat)==9:
        outputfile.write("\n  {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f}".format(inplattice[0,0]*nx,inplattice[0,1]*nx,inplattice[0,2]*nx,inplattice[1,0]*ny,inplattice[1,1]*ny,inplattice[1,2]*ny,inplattice[2,0]*nz,inplattice[2,1]*nz,inplattice[2,2]*nz))
    elif len(inplat)==0:
        print("Introduce lattice vectors (can also be given in 2nd line of xyz")
        latvec1 = input("Write 1st lattice vector: ").split()
        if len(latvec1)==1:
            inplattice[0,0]=float(latvec1[0])
        elif len(latvec1)==3:
            inplattice[0,0]=float(latvec1[0])
            inplattice[0,1]=float(latvec1[1])
            inplattice[0,2]=float(latvec1[2])
        else:
            print("Invalid vector, bye!")
            quit()            
        latvec2 = input("Write 2nd lattice vector: ").split()
        if len(latvec2)==1:
            inplattice[1,1]=float(latvec2[0])
        elif len(latvec1)==3:
            inplattice[1,0]=float(latvec2[0])
            inplattice[1,1]=float(latvec2[1])
            inplattice[1,2]=float(latvec2[2])
        else:
            print("Invalid vector, bye!")
            quit()            
        latvec3 = input("Write 3rd lattice vector: ").split()
        if len(latvec3)==1:
            inplattice[2,2]=float(latvec3[0])
        elif len(latvec3)==3:
            inplattice[2,0]=float(latvec3[0])
            inplattice[2,1]=float(latvec3[1])
            inplattice[2,2]=float(latvec3[2])
        else:
            print("Invalid vector, bye!")
            quit()             
        outputfile.write("\n  {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f}".format(inplattice[0,0]*nx,inplattice[0,1]*nx,inplattice[0,2]*nx,inplattice[1,0]*ny,inplattice[1,1]*ny,inplattice[1,2]*ny,inplattice[2,0]*nz,inplattice[2,1]*nz,inplattice[2,2]*nz))
    if args.stack=='all':
        for ix in range(nx):
            for iy in range(ny):
                for iz in range(nz):
                    for iatom in range(natoms):
                        coordinates = inpxyz[iatom]+ix*inplattice[0]+iy*inplattice[1]+iz*inplattice[2] 
                        outputfile.write("\n{:<2}   {:14.6f}  {:14.6f}  {:14.6f}".format(inptypes[iatom],coordinates[0],coordinates[1],coordinates[2]))
    elif args.stack=='each':
        for iatom in range(natoms):
            for ix in range(nx):
                for iy in range(ny):
                    for iz in range(nz):
                        coordinates = inpxyz[iatom]+ix*inplattice[0]+iy*inplattice[1]+iz*inplattice[2]
                        outputfile.write("\n{:<2}   {:14.6f}  {:14.6f}  {:14.6f}".format(inptypes[iatom],coordinates[0],coordinates[1],coordinates[2]))
    else:
        print("Wrong stacking option, bye!")
        quit()
    outputfile.close()
# MODE 6: REORGANIZE STRUCTURE AROUND 1 ATOM BY INDEX
elif args.inpmode==6:
    print("\nMode 6: Reorganize structure around 1 atom by index (optional -nsc option to generate a larger supercell)\n")
    if args.refindex==-1:
        refindex = int(input("Select the index of the atom (also given by -refindex): "))
    else:
        refindex = args.refindex
    if refindex < 1 or refindex > natoms:
        print("Invalid reference index, bye!")
        quit()
    else:
        refindex = refindex - 1
        print("\nSelected atom index {:3d} of type {:>2} at position {:8.6f} {:8.6f} {:8.6f}\n".format(refindex+1,inptypes[refindex],inpxyz[refindex,0],inpxyz[refindex,1],inpxyz[refindex,2]))
    if args.outfilename=='None':
        outfilename = input("Select the output filename: ")
    else:
        outfilename = args.outfilename
    outputfile = open(outfilename,"w")
    outputfile.write("  {:d} ".format(natoms))
    if len(inplat)==0:
        print("Introduce lattice vectors (can also be given in 2nd line of xyz")
        latvec1 = input("Write 1st lattice vector: ").split()
        if len(latvec1)==1:
            inplattice[0,0]=float(latvec1[0])
        elif len(latvec1)==3:
            inplattice[0,0]=float(latvec1[0])
            inplattice[0,1]=float(latvec1[1])
            inplattice[0,2]=float(latvec1[2])
        else:
            print("Invalid vector, bye!")
            quit()
        latvec2 = input("Write 2nd lattice vector: ").split()
        if len(latvec2)==1:
            inplattice[1,1]=float(latvec2[0])
        elif len(latvec1)==3:
            inplattice[1,0]=float(latvec2[0])
            inplattice[1,1]=float(latvec2[1])
            inplattice[1,2]=float(latvec2[2])
        else:
            print("Invalid vector, bye!")
            quit()
        latvec3 = input("Write 3rd lattice vector: ").split()
        if len(latvec3)==1:
            inplattice[2,2]=float(latvec3[0])
        elif len(latvec3)==3:
            inplattice[2,0]=float(latvec3[0])
            inplattice[2,1]=float(latvec3[1])
            inplattice[2,2]=float(latvec3[2])
        else:
            print("Invalid vector, bye!")
            quit()
        outputfile.write("\n  {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f} {:12.6f}".format(inplattice[0,0]*nx,inplattice[0,1]*nx,inplattice[0,2]*nx,inplattice[1,0]*ny,inplattice[1,1]*ny,inplattice[1,2]*ny,inplattice[2,0]*nz,inplattice[2,1]*nz,inplattice[2,2]*nz))
    else:
        outputfile.write("\n")
        outputfile.write(inputlines[1])
    nsc = args.nsc
    if nsc==0:
        nsc=1
    ncells = (2*nsc+1)**3
    supercellxyz = np.zeros((natoms*ncells,3))
    iglob=0
    for ix in range(-nsc,nsc+1):
        for iy in range(-nsc,nsc+1):
            for iz in range(-nsc,nsc+1):
                for iatom in range(natoms):
                    supercellxyz[iglob,:] = inpxyz[iatom] + ix*inplattice[0] + iy*inplattice[1] + iz*inplattice[2]
                    iglob=iglob+1
    print("This might take a while...")
    tstart=timer()
    distances = scipy.spatial.distance.cdist(supercellxyz, supercellxyz)
    tend=timer()
    print(tend-tstart)
    outindex = np.zeros(natoms, dtype=int)
    atsavailable = np.ones(natoms)
    outindex[refindex] = refindex + (nsc*(2*nsc+1)**2+nsc*(2*nsc+1)+nsc)*natoms
    atsavailable[refindex] = 0
    while np.sum(atsavailable)>0:
        print("{:d} atoms left...".format(int(np.sum(atsavailable))))
        icloser=-1
        dcloser=1e8
        for iatom1 in range(ncells*natoms):
            if atsavailable[iatom1%natoms]==1:
                for iatom2 in range(natoms):
                    if atsavailable[iatom2]==0:
                        dactual = distances[outindex[iatom2],iatom1]
                        if dactual<dcloser:
                            icloser=iatom1
                            dcloser=dactual
        atsavailable[icloser%natoms]=0
        outindex[icloser%natoms]=icloser
    for iatom in range(natoms):
        outputfile.write("{:<2}   {:14.6f}  {:14.6f}  {:14.6f}\n".format(inptypes[iatom],supercellxyz[outindex[iatom],0],supercellxyz[outindex[iatom],1],supercellxyz[outindex[iatom],2]))
    outputfile.close()
# MODE 7: CREATE A XYZ FILE AROUND A GIVEN ATOM BY DISTANCE
elif args.inpmode==7:
    print("\nMode 7: Create a xyz file around a given atom by distance (optional -nsc to create a supercell)\n")
    if args.refindex==-1:
        refindex = int(input("Select the index of the atom (also given by -refindex): "))
    else:
        refindex = args.refindex
    if refindex < 1 or refindex > natoms:
        print("Invalid reference index, bye!")
        quit()
    else:
        refindex = refindex - 1
    if args.dcrit==-1:
        dcrit = float(input("Select maximum distance to show (also given by -dcrit): "))
    else:
        dcrit = args.dcrit
    if dcrit <=0:
        print("Invalid critical distance, bye!")
        quit()
    if args.outfilename=='None':
        outfilename = input("Select the output filename: ")
    else:
        outfilename = args.outfilename
    outputfile = open(outfilename,"w")
    nsc = args.nsc
    if len(inplat)==0 and nsc!=0:
        print("Introduce lattice vectors (can also be given in 2nd line of xyz")
        latvec1 = input("Write 1st lattice vector: ").split()
        if len(latvec1)==1:
            inplattice[0,0]=float(latvec1[0])
        elif len(latvec1)==3:
            inplattice[0,0]=float(latvec1[0])
            inplattice[0,1]=float(latvec1[1])
            inplattice[0,2]=float(latvec1[2])
        else:
            print("Invalid vector, bye!")
            quit()
        latvec2 = input("Write 2nd lattice vector: ").split()
        if len(latvec2)==1:
            inplattice[1,1]=float(latvec2[0])
        elif len(latvec1)==3:
            inplattice[1,0]=float(latvec2[0])
            inplattice[1,1]=float(latvec2[1])
            inplattice[1,2]=float(latvec2[2])
        else:
            print("Invalid vector, bye!")
            quit()
        latvec3 = input("Write 3rd lattice vector: ").split()
        if len(latvec3)==1:
            inplattice[2,2]=float(latvec3[0])
        elif len(latvec3)==3:
            inplattice[2,0]=float(latvec3[0])
            inplattice[2,1]=float(latvec3[1])
            inplattice[2,2]=float(latvec3[2])
        else:
            print("Invalid vector, bye!")
            quit()
    ncells = (2*nsc+1)**3
    supercellxyz = np.zeros((natoms*ncells,3))
    iglob=0
    for ix in range(-nsc,nsc+1):
        for iy in range(-nsc,nsc+1):
            for iz in range(-nsc,nsc+1):
                for iatom in range(natoms):
                    supercellxyz[iglob,:] = inpxyz[iatom] + ix*inplattice[0] + iy*inplattice[1] + iz*inplattice[2] - inpxyz[refindex]
                    iglob=iglob+1
    refglobindex = refindex + (nsc*(2*nsc+1)**2+nsc*(2*nsc+1)+nsc)*natoms
    listofatoms = refglobindex
    for iatom in range(natoms*ncells):
        if np.linalg.norm(supercellxyz[iatom])<dcrit and iatom != refglobindex:
            listofatoms = np.append(listofatoms,iatom)
    outputfile.write("  {:d} \n\n".format(len(listofatoms)))
    for iatom in listofatoms:
